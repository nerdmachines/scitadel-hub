#!/usr/bin/env python3
"""Write <docs-root>/issues-index.md from the trace graph (Python 3.11+ only).

The rendering lives in tools/trace-check, which also checks this file for drift,
so the generator and the gate cannot disagree.
"""
import argparse
from pathlib import Path
import runpy
import sys

GATE = runpy.run_path(str(Path(__file__).resolve().parent / 'trace-check'))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('docs', type=Path, help='documentation root')
    args = parser.parse_args()
    if not args.docs.is_dir():
        print(f'{args.docs}: docs root is not a directory', file=sys.stderr)
        return 1
    errors, nodes, edges, _ = GATE['load'](args.docs)
    if errors:
        for line in errors:
            print(line, file=sys.stderr)
        print(f'{GATE["INDEX"]}: not written; fix the trace files first', file=sys.stderr)
        return 1
    (args.docs / GATE['INDEX']).write_text(GATE['render_index'](nodes, edges))
    return 0


if __name__ == '__main__':
    sys.exit(main())
